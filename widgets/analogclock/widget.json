{
  "id": "fullwidget.analogclock",
  "name": { "zh-TW": "指針時鐘", "zh-CN": "指针时钟", "en": "Analog clock" },
  "description": { "zh-TW": "有指針的錶盤，可選時區", "zh-CN": "有指针的表盘，可选时区", "en": "A clock face with hands, any time zone" },
  "version": "1.1.0",
  "author": "FullWidget",
  "entry": "index.html",
  "icon": "icon.svg",
  "category": "time",
  "preview": "preview/{theme}.{lang}.webp",
  "size": { "width": 220, "height": 220, "minWidth": 110, "minHeight": 110, "maxWidth": 640, "maxHeight": 640, "grow": 1 },
  "permissions": [],
  "settings": [
    { "key": "showSeconds", "type": "toggle", "label": { "zh-TW": "秒針", "zh-CN": "秒针", "en": "Second hand" }, "default": true },
    { "key": "numerals", "type": "select", "label": { "zh-TW": "數字", "zh-CN": "数字", "en": "Numerals" }, "default": "quarters",
      "options": [
        { "value": "none", "label": { "zh-TW": "不顯示", "zh-CN": "不显示", "en": "None" } },
        { "value": "quarters", "label": "12 · 3 · 6 · 9" },
        { "value": "all", "label": { "zh-TW": "全部", "zh-CN": "全部", "en": "All" } }
      ] },
    { "key": "showDate", "type": "toggle", "label": { "zh-TW": "顯示日期", "zh-CN": "显示日期", "en": "Show date" }, "default": true },
    { "key": "timezone", "type": "select", "label": { "zh-TW": "時區", "zh-CN": "时区", "en": "Time zone" }, "default": "local",
      "options": [
        { "value": "local", "label": { "zh-TW": "本機", "zh-CN": "本机", "en": "This PC" } },
        { "value": "Asia/Taipei", "label": { "zh-TW": "台北", "zh-CN": "台北", "en": "Taipei" } },
        { "value": "Asia/Shanghai", "label": { "zh-TW": "上海", "zh-CN": "上海", "en": "Shanghai" } },
        { "value": "Asia/Hong_Kong", "label": { "zh-TW": "香港", "zh-CN": "香港", "en": "Hong Kong" } },
        { "value": "Asia/Tokyo", "label": { "zh-TW": "東京", "zh-CN": "东京", "en": "Tokyo" } },
        { "value": "Asia/Singapore", "label": { "zh-TW": "新加坡", "zh-CN": "新加坡", "en": "Singapore" } },
        { "value": "Europe/London", "label": { "zh-TW": "倫敦", "zh-CN": "伦敦", "en": "London" } },
        { "value": "Europe/Paris", "label": { "zh-TW": "巴黎", "zh-CN": "巴黎", "en": "Paris" } },
        { "value": "America/New_York", "label": { "zh-TW": "紐約", "zh-CN": "纽约", "en": "New York" } },
        { "value": "America/Los_Angeles", "label": { "zh-TW": "洛杉磯", "zh-CN": "洛杉矶", "en": "Los Angeles" } },
        { "value": "Australia/Sydney", "label": { "zh-TW": "雪梨", "zh-CN": "悉尼", "en": "Sydney" } },
        { "value": "UTC", "label": "UTC" }
      ] }
  ]
}
